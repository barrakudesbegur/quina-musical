{
  // The Quina Musical cloud: one Worker and one GameRoom Durable Object per edition (docs/deploy-plan.md).
  // Secrets (Access team domain, AUDs, allowed emails, service tokens) are set with `wrangler secret put`
  // and never written here; locally they come from .dev.vars.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quina-cloud",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  // The cloud's own hostname, so Access can protect paths (/api, /ws/console, /ws/show) and leave /feed public.
  // Cloudflare creates this NEW record and its certificate only; nothing else in the zone changes.
  "routes": [{ "pattern": "quina-dev.barrakudesbegur.org", "custom_domain": true }],
  "preview_urls": false,
  "vars": {
    // The year tag in the players' links (quina.barrakudesbegur.org/26/123); it names the GameRoom.
    "EDITION": "26"
  },
  "durable_objects": {
    "bindings": [{ "name": "GAME_ROOM", "class_name": "GameRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom"] }],
  // Static files (the player app, covers) are served without running the Worker, so they cost no requests.
  // Only the run_worker_first paths reach it. dist/ is built by `npm run assets` (scripts/assets.ts) from static/,
  // the UI build, the cards and the covers; the player at the root takes every other page (/26/123).
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/feed", "/ws/*", "/api/*", "/media/*"]
  },
  // R2 for the pool's media (C3, laptop sync). Off until the bucket exists (docs/deploy-plan.md step 4): with this
  // block, a deploy fails without the bucket. Without it, /api/sync answers 503 and everything else works.
  // "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "quina-media" }],
  "observability": { "enabled": true }
}
