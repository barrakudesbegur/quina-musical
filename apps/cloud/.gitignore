node_modules/
.wrangler/
# Local secrets and the dev bypass (copy .dev.vars.example).
.dev.vars
.dev.vars.*
!.dev.vars.example
# The laptop link's secrets (its folder, with the on-disk journal copy, is data/link/, ignored there).
.env.link
# Generated by `wrangler types` (npm run types).
worker-configuration.d.ts
# Patches sent to other sessions for review; they live in the protocol once merged.
proposals/
# A test copy of wrangler.jsonc without the R2 binding (loadtest/dev-server.ts).
wrangler.no-media-test.*.jsonc
wrangler.media-test.jsonc
# Built by `npm run assets`: the UI build and the album covers never go into the public repo.
dist/
.assets-cache/
# Load-test raw output (the summary report is committed under reports/).
loadtest/out/
