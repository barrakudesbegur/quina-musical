{
  "name": "@quina/show",
  "private": true,
  "description": "The show: the engine, the show page and the relay. Its Vite build also builds the screens in apps/.",
  "type": "module",
  "scripts": {
    "dev": "node relay/server.ts",
    "start": "vite build && node relay/server.ts --dist",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json && svelte-check --tsconfig ./tsconfig.json --threshold error",
    "test": "npm run typecheck && node --test \"tests/*.test.ts\" && npm run test:ui",
    "prep": "../../tools/prep/.venv/bin/python ../../tools/prep/prepare.py",
    "test:pipeline": "../../tools/prep/.venv/bin/python -m pytest ../../tools/prep/tests",
    "analyze": "../../tools/prep/.venv/bin/python ../../tools/prep/analyze.py",
    "validate": "../../tools/prep/.venv/bin/python ../../tools/prep/validate.py",
    "test:ui": "tsc -p tsconfig.ui.json && svelte-check --tsconfig ./tsconfig.ui.json --threshold error && node --test \"tests/ui/**/*.test.ts\""
  },
  "dependencies": {
    "@quina/protocol": "*",
    "qrcode": "1.5.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "26.6.6",
    "@types/qrcode": "1.5.5",
    "@types/ws": "8.18.2",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "typescript": "5.9.3",
    "vite": "8.3.7"
  },
  "engines": {
    "node": ">=23.6"
  }
}
