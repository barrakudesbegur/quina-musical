{
  "name": "quina-mixer-poc",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node relay/server.ts",
    "start": "node relay/server.ts --dist",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json && svelte-check --tsconfig ./tsconfig.json --threshold error",
    "test": "npm run typecheck && node --test \"tests/**/*.test.ts\"",
    "prep": "analysis/.venv/bin/python analysis/prepare.py",
    "test:pipeline": "analysis/.venv/bin/python -m pytest analysis/tests",
    "analyze": "analysis/.venv/bin/python analysis/analyze.py",
    "validate": "analysis/.venv/bin/python analysis/validate.py"
  },
  "dependencies": {
    "@quina/protocol": "file:protocol",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "26.6.6",
    "@types/ws": "8.18.2",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "typescript": "5.9.3",
    "vite": "8.3.7"
  },
  "engines": {
    "node": ">=23.6"
  }
}
